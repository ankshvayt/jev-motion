{
  "$comment": "Video spec. Checked by spec/validate.py, which supports type, required, properties, additionalProperties, items, enum, minItems, maxItems, minimum, maximum and pattern. Top-level and block objects stay open so a spec may carry extra keys jevm ignores; the objects that code generates and indexes into (words, sentences, caption groups) are closed.",
  "type": "object",
  "required": ["spec_version", "project", "format", "canvas", "kit", "transcript", "units", "assets", "constraints", "creator_declared", "decide"],
  "properties": {
    "spec_version": {"type": "string", "enum": ["1.0"]},
    "project": {
      "type": "object",
      "required": ["id", "title", "root"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "title": {"type": "string"},
        "root": {"type": "string"}
      }
    },
    "format": {
      "type": "object",
      "required": ["id", "family", "origin", "declared_by", "modules"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "family": {"type": "string", "enum": ["short", "long"]},
        "origin": {"type": "string", "enum": ["declared"]},
        "declared_by": {"type": "string"},
        "modules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "canvas": {
      "type": "object",
      "required": ["aspect", "width", "height", "fps", "duration_s"],
      "properties": {
        "aspect": {"type": "string", "pattern": "^\\d+:\\d+$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "minimum": 1},
        "duration_s": {"type": "number", "minimum": 0}
      }
    },
    "kit": {
      "type": "object",
      "required": ["id", "manifest", "manifest_sha256", "canvas", "theme_policy", "theme", "overrides"],
      "properties": {
        "id": {"type": "string"},
        "manifest": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canvas": {"type": "string"},
        "theme_policy": {"type": "string", "enum": ["per_scene", "one_per_video"]},
        "theme": {"type": "string"},
        "overrides": {"type": "object"}
      }
    },
    "transcript": {
      "type": "object",
      "required": ["origin", "source", "text", "words"],
      "properties": {
        "origin": {"type": "string"},
        "source": {"type": "string"},
        "text": {"type": "string"},
        "words": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "start", "end"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^w\\d+$"},
              "text": {"type": "string"},
              "start": {"type": "number"},
              "end": {"type": "number"},
              "speaker": {"type": "string"},
              "conf": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "units": {
      "type": "object",
      "required": ["sentences", "caption_groups"],
      "properties": {
        "sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "words", "start", "end"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^sn\\d+$"},
              "words": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^w\\d+$"}},
              "start": {"type": "number"},
              "end": {"type": "number"}
            }
          }
        },
        "caption_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "words", "start", "end", "lines", "sentence"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^cg\\d+$"},
              "words": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^w\\d+$"}},
              "start": {"type": "number"},
              "end": {"type": "number"},
              "lines": {"type": "integer", "minimum": 1},
              "sentence": {"type": "string", "pattern": "^sn\\d+$"}
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "uri", "sensitivity"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "kind": {"type": "string", "enum": ["video", "screen_recording", "screenshot", "image", "logo", "audio", "source_text"]},
          "uri": {"type": "string"},
          "description": {"type": "string"},
          "sensitivity": {"type": "string", "enum": ["public", "own_render", "private"]},
          "layer": {"type": "string", "enum": ["overlay", "footage", "third_party_ui"]},
          "duration_s": {"type": "number", "minimum": 0},
          "dims": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
          "provenance": {"type": "string"},
          "rights": {"type": "string"}
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["safe", "text_min_px", "captions", "highlight", "emphasis_non_word"],
      "properties": {
        "safe": {
          "type": "object",
          "required": ["from"],
          "properties": {"from": {"type": "string", "pattern": "^(platform|kit|format|creator|workspace)(\\+(platform|kit|format|creator|workspace))*$"}}
        },
        "text_min_px": {
          "type": "object",
          "required": ["ui", "mono", "from"],
          "properties": {
            "ui": {"type": "integer", "minimum": 1},
            "mono": {"type": "integer", "minimum": 1},
            "from": {"type": "string", "pattern": "^(platform|kit|format|creator|workspace)(\\+(platform|kit|format|creator|workspace))*$"}
          }
        },
        "captions": {
          "type": "object",
          "required": ["max_words_per_line", "max_lines", "from"],
          "properties": {
            "max_words_per_line": {"type": "integer", "minimum": 1},
            "max_lines": {"type": "integer", "minimum": 1},
            "from": {"type": "string", "pattern": "^(platform|kit|format|creator|workspace)(\\+(platform|kit|format|creator|workspace))*$"}
          }
        },
        "highlight": {
          "type": "object",
          "required": ["per_caption_line", "per_frame", "allowed_on", "density", "from"],
          "properties": {
            "per_caption_line": {"type": "integer", "minimum": 0},
            "per_frame": {"type": "integer", "minimum": 0},
            "allowed_on": {"type": "array", "items": {"type": "string"}},
            "density": {"type": "number", "minimum": 0, "maximum": 1},
            "from": {"type": "string", "pattern": "^(platform|kit|format|creator|workspace)(\\+(platform|kit|format|creator|workspace))*$"}
          }
        },
        "emphasis_non_word": {
          "type": "object",
          "required": ["token", "from"],
          "properties": {
            "token": {"type": ["string", "null"]},
            "from": {"type": "string", "pattern": "^(platform|kit|format|creator|workspace)(\\+(platform|kit|format|creator|workspace))*$"}
          }
        }
      }
    },
    "creator_declared": {
      "type": "object",
      "properties": {
        "highlight_density": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "decide": {
      "type": "object",
      "required": ["policy", "budget_usd", "backends"],
      "properties": {
        "policy": {"type": "string"},
        "budget_usd": {"type": "number", "minimum": 0},
        "backends": {
          "type": "object",
          "required": ["jev", "local"],
          "properties": {
            "jev": {
              "type": "object",
              "required": ["models", "concurrency"],
              "properties": {
                "models": {
                  "type": "object",
                  "required": ["text", "image"],
                  "properties": {"text": {"type": "string"}, "image": {"type": "string"}}
                },
                "concurrency": {"type": "integer", "minimum": 1}
              }
            },
            "local": {
              "type": "object",
              "required": ["name", "url", "model", "concurrency"],
              "properties": {
                "name": {"type": "string"},
                "url": {"type": "string"},
                "model": {"type": "string"},
                "concurrency": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
